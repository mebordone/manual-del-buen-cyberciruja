@startuml
title Guía de recuperación básica — Cyberciruja (Diagrama de flujo)

start

:Preparación inicial;
note right
 Conectar: energía, monitor,
 teclado, mouse. Tener
 pendrive live USB.
end note

:Encender equipo;
if (Se enciende? \n(ventilador / LED)) then (sí)
  :Inspección visual rápida;
  note right
   Abrir con equipo apagado;
   revisar polvo, cables,
   estado disco (ruidos).
  end note

  if (Se ve señal de vídeo?) then (sí)
    if (Entra al sistema operativo?) then (sí)
      :Probar rendimiento;
      if (Rendimiento aceptable?) then (sí)
        :Marcar como LISTO para uso;
        stop
      else (no)
        :Acción fácil: limpiar, \nreseat RAM, considerar SSD o +RAM;
        :Instalar/optimizar SO liviano;
        stop
      endif
    else (no)
      :Arrancar desde live-USB;
      if (Live-USB funciona?) then (sí)
        :Conclusión: disco/OS corrupto o lento;
        :Acción fácil: clonar / cambiar HDD→SSD \n o reinstalar SO;
        stop
      else (no)
        :Probar reseat de RAM / otro módulo;
        if (Mejora?) then (sí)
          :Reemplazar módulo RAM defectuoso;
          stop
        else (no)
          :Marcar como REQUIERE DIAGNÓSTICO AVANZADO\n(placa, chipset, vídeo integrado, etc.);
          stop
        endif
      endif
    endif
  else (no)
    :Probar cable de vídeo y otro monitor;
    if (Se soluciona?) then (sí)
      :Volver a intentar arranque / live-USB;
      ->[return] start
    else (no)
      :Marcar como REQUIERE DIAGNÓSTICO AVANZADO\n(posible GPU/placa/mal contacto);
      stop
    endif
  endif

else (no)
  :Revisar: toma, cable de alimentación, pulsador;
  if (Fuente de repuesto disponible?) then (sí)
    :Probar con PSU de repuesto;
    if (Enciende con PSU repuesto?) then (sí)
      :Reemplazar PSU; volver a pruebas anteriores;
      ->[return] start
    else (no)
      :Marcar como REQUIERE DIAGNÓSTICO AVANZADO;
      stop
    endif
  else (no)
    :Marcar como POSIBLE FALLO DE PSU — llevar PSU de repuesto\n(en la visita técnica) o marcar para revisión;
    stop
  endif
endif

@enduml